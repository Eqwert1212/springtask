# Optional local settings (Java properties syntax, without quotes).
# Copy these settings into .env.local only on first setup; never overwrite existing credentials.
# Defaults match compose.yaml. For an existing PostgreSQL server adjust port and credentials.
DB_URL=jdbc:postgresql://localhost:5433/springtask
DB_USER=springtask
DB_PASSWORD=springtask_local
TEST_DB_URL=jdbc:postgresql://localhost:5433/springtask_test
TEST_DB_USER=springtask
TEST_DB_PASSWORD=springtask_local
SERVER_PORT=8000
